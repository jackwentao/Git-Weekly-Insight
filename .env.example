# Required for scanning: point to an existing directory containing Git repositories.
# An absolute path also works. Relative paths are resolved from the command's cwd.
WORK_DIR=.
SINCE_DAYS=7

# Required only for generate / the weekly-report API. Leave empty for dry-run.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_RETRY_COUNT=2
DEEPSEEK_TIMEOUT_MS=15000
DEEPSEEK_BACKOFF_MS=500

# Optional local notes file. Leave empty to use Git history only.
THOUGHT_PATH=
